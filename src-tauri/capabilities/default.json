{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Controller and subtitle overlay permissions",
  "windows": [
    "main",
    "overlay",
    "overlay-chrome",
    "overlay-panel"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://help.aliyun.com/*" },
        { "url": "https://www.alibabacloud.com/*" },
        { "url": "https://developers.openai.com/*" },
        { "url": "https://soniox.com/*" },
        { "url": "https://github.com/Deanwfy/OverLingo/*" }
      ]
    }
  ]
}
